{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Skill\"",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/SkillGuard/SkillGuard.ts"
          }
        ]
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm run dev|pnpm( run)? dev|yarn dev|bun run dev)\"",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/DevServerBlocker/DevServerBlocker.ts"
          }
        ]
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm (install|test)|pnpm (install|test)|yarn (install|test)|bun (install|test)|cargo build|make|docker|pytest|vitest|playwright)\"",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/TmuxSuggest/TmuxSuggest.ts"
          }
        ]
      },
      {
        "matcher": "tool == \"Write\" && tool_input.file_path matches \"\\\\.(md|txt)$\" && !(tool_input.file_path matches \"README\\\\.md|CLAUDE\\\\.md|AGENTS\\\\.md|CONTRIBUTING\\\\.md|context-.*\\\\.md\")",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/WriteBlocker/WriteBlocker.ts"
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" || tool == \"Write\"",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/SuggestCompact/SuggestCompact.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/SessionAutoName/SessionAutoName.ts"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/PrePlan/PrePlan.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Bash\"",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/PRDetect/PRDetect.ts"
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/PostEditCheck/PostEditCheck.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/rohirikman/.claude/hooks/Cleanup/Cleanup.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/rohirikman/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "ltm@ltm": true,
    "dev-team@rohirikman": false,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      },
      "autoUpdate": true
    },
    "ltm": {
      "source": {
        "source": "git",
        "url": "https://github.com/RohiRIK/claude-ltm-plugin.git"
      },
      "autoUpdate": true
    },
    "rohirikman": {
      "source": {
        "source": "github",
        "repo": "RohiRIK/dev-team"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
